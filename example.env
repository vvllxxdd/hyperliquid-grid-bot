# Hyperliquid credentials
PRIVATE_KEY=your-private-key-here
WALLET_ADDRESS=your-wallet-address-here
MAINNET=true            # Omit for testnet

# Bot behavior settings
SPREAD=0.005           # Grid spread between orders
ATR_CANDLE=1m          # Candle interval to calculata ATR - volatility adjusted spreads
ORDER_SIZE=10          # Size per order (in HYPE or your trading token units)
GRID_LEVELS=3          # Number of grid levels up/dow
SYMBOL=HYPE            # Trading pair symbol (must match Hyperliquid's format)
SPOT_OR_PERP=PERP      # Whether the coin is on the spot or perp market
INTERVAL_MS=5000       # Bot cycle interval in milliseconds (5000ms = 5 seconds)
HEDGE_MODE=true        # Hedge mode will only place reduce-only buy orders